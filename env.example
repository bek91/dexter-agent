# LLM API Key
OPENAI_API_KEY=your-openai-api-key

# Local Graphiti API (optional for local search)
# If GROUP_ID is provided (single or comma-separated), the search tool will
# default to these groups when group_ids is omitted by the LLM/tool call.
GRAPHITI_API_KEY=your-graphiti-api-key
GROUP_ID=your-group-id-or-comma-separated-ids

# (Deprecated) Financial datasets key — not used by current tools
# FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
